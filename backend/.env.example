GEMINI_API_KEY=
# Gemini model used by the primary provider.
GEMINI_MODEL=gemini-2.5-flash
# Ollama server and model used for local fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
DATABASE_URL=sqlite:///backend/data/otran.db
# Use seed files instead of network fetching.
OFFLINE_DEMO=false
# Allow switching to Ollama after Gemini rate limits.
LLM_FALLBACK=true
# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Select graph or legacy orchestration.
ORCHESTRATOR=graph
